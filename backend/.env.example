# Runtime. "production" disables docs, rejects CORS *, and forbids DEV_SKIP_LICENSE.
APP_ENV=development
DEBUG=false

# Public placeholders until real domains are confirmed. Not used by the API process.
APP_URL=https://[WEB_PRODUCTION_DOMAIN]
API_URL=https://[API_PRODUCTION_DOMAIN]

# Bind address for the process manager / container. uvicorn reads these only if you pass them.
HOST=127.0.0.1
PORT=8000

# Groq — server-side only. Never put this in the extension or VITE_* variables.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=allam-2-7b
GROQ_TIMEOUT_SECONDS=5

# Bump when the classifier prompt or allowed enum changes so in-memory cache does not reuse old verdicts.
CLASSIFIER_VERSION=v1

# true only on a local machine. Production must leave this false.
DEV_SKIP_LICENSE=true

# Lemon Squeezy — server-side only. Required in production. No card data is stored.
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key_here
# Unused by the current validate-only flow. Keep empty unless you add store-scoped checks.
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_PRODUCT_ID=

# Valid license cache TTL in seconds (alias: LICENSE_TTL_SECONDS). Extension cache uses the same 900s window.
LICENSE_CACHE_TTL=900
INVALID_LICENSE_TTL_SECONDS=90
WORD_TTL_SECONDS=86400

# In-process sliding windows. Per client IP. Generous enough for shared NAT.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANALYZE_PER_MINUTE=120
RATE_LIMIT_LICENSE_PER_MINUTE=20

# Comma-separated browser origins. Do not set to * in production.
# Chrome and Edge extension pages use chrome-extension://. Empty = extension-only.
CORS_ORIGINS=
# Optional. Comma-separated 32-character Chromium IDs (Chrome and/or Edge).
# Empty = any chrome-extension:// origin. Do not use *.
EXTENSION_IDS=

# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# No database is used. Do not set DATABASE_URL.
